class NodeSimple<T> {
    T data;
    NodeSimple<T> next;
    public NodeSimple(T data) { this.data = data; this.next = null; }
}

class NodeDouble<T> {
    T data;
    NodeDouble<T> next;
    NodeDouble<T> prev;
    public NodeDouble(T data) { this.data = data; this.next = null; this.prev = null; }
}

class ListaSimpleSinCabezaSinCola<T> {
    private NodeSimple<T> head;
    private int size;

    public void pushFront(T data) {
        NodeSimple<T> n = new NodeSimple<>(data);
        n.next = head;
        head = n;
        size++;
    }

    public void pushBack(T data) {
        NodeSimple<T> n = new NodeSimple<>(data);
        if (head == null) head = n;
        else {
            NodeSimple<T> cur = head;
            while (cur.next != null) cur = cur.next;
            cur.next = n;
        }
        size++;
    }

    public T popFront() {
        if (head == null) return null;
        T d = head.data;
        head = head.next;
        size--;
        return d;
    }

    public T popBack() {
        if (head == null) return null;
        if (head.next == null) { T d = head.data; head = null; size--; return d; }
        NodeSimple<T> cur = head;
        while (cur.next.next != null) cur = cur.next;
        T d = cur.next.data;
        cur.next = null;
        size--;
        return d;
    }

    public T find(T data) {
        NodeSimple<T> cur = head;
        while (cur != null) {
            if (cur.data.equals(data)) return cur.data;
            cur = cur.next;
        }
        return null;
    }

    public void erase(T data) {
        if (head == null) return;
        if (head.data.equals(data)) { popFront(); return; }
        NodeSimple<T> cur = head;
        while (cur.next != null && !cur.next.data.equals(data)) cur = cur.next;
        if (cur.next != null) { cur.next = cur.next.next; size--; }
    }

    public void addBefore(T ref, T data) {
        if (head == null) return;
        if (head.data.equals(ref)) { pushFront(data); return; }
        NodeSimple<T> cur = head;
        while (cur.next != null && !cur.next.data.equals(ref)) cur = cur.next;
        if (cur.next != null) {
            NodeSimple<T> n = new NodeSimple<>(data);
            n.next = cur.next;
            cur.next = n;
            size++;
        }
    }

    public void addAfter(T ref, T data) {
        NodeSimple<T> cur = head;
        while (cur != null && !cur.data.equals(ref)) cur = cur.next;
        if (cur != null) {
            NodeSimple<T> n = new NodeSimple<>(data);
            n.next = cur.next;
            cur.next = n;
            size++;
        }
    }

    public boolean empty() { return head == null; }
    public int size() { return size; }
    public T topBack() {
        if (head == null) return null;
        NodeSimple<T> cur = head;
        while (cur.next != null) cur = cur.next;
        return cur.data;
    }
}


class ListaSimpleConCabezaConCola<T> {
    private NodeSimple<T> head;
    private NodeSimple<T> tail;
    private int size;

    public void pushFront(T data) {
        NodeSimple<T> n = new NodeSimple<>(data);
        if (head == null) { head = n; tail = n; }
        else { n.next = head; head = n; }
        size++;
    }

    public void pushBack(T data) {
        NodeSimple<T> n = new NodeSimple<>(data);
        if (tail == null) { head = n; tail = n; }
        else { tail.next = n; tail = n; }
        size++;
    }

    public T popFront() {
        if (head == null) return null;
        T d = head.data;
        head = head.next;
        if (head == null) tail = null;
        size--;
        return d;
    }

    public T popBack() {
        if (head == null) return null;
        T d = tail.data;
        if (head == tail) { head = null; tail = null; }
        else {
            NodeSimple<T> cur = head;
            while (cur.next != tail) cur = cur.next;
            cur.next = null;
            tail = cur;
        }
        size--;
        return d;
    }

    public T find(T data) {
        NodeSimple<T> cur = head;
        while (cur != null) {
            if (cur.data.equals(data)) return cur.data;
            cur = cur.next;
        }
        return null;
    }

    public void erase(T data) {
        if (head == null) return;
        if (head.data.equals(data)) { popFront(); return; }
        NodeSimple<T> cur = head;
        while (cur.next != null && !cur.next.data.equals(data)) cur = cur.next;
        if (cur.next != null) {
            if (cur.next == tail) tail = cur;
            cur.next = cur.next.next;
            size--;
        }
    }

    public void addBefore(T ref, T data) {
        if (head == null) return;
        if (head.data.equals(ref)) { pushFront(data); return; }
        NodeSimple<T> cur = head;
        while (cur.next != null && !cur.next.data.equals(ref)) cur = cur.next;
        if (cur.next != null) {
            NodeSimple<T> n = new NodeSimple<>(data);
            n.next = cur.next;
            cur.next = n;
            size++;
        }
    }

    public void addAfter(T ref, T data) {
        NodeSimple<T> cur = head;
        while (cur != null && !cur.data.equals(ref)) cur = cur.next;
        if (cur != null) {
            NodeSimple<T> n = new NodeSimple<>(data);
            n.next = cur.next;
            cur.next = n;
            if (cur == tail) tail = n;
            size++;
        }
    }

    public boolean empty() { return head == null; }
    public int size() { return size; }
    public T topBack() { return tail == null ? null : tail.data; }
}


