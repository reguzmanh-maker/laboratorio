interface MyStack<T> {
    void push(T x);
    T pop();
    T peek();
    boolean isEmpty();
    int size();
    void delete(T n);
}

interface MyQueue<T> {
    void enqueue(T x);
    T dequeue();
    T front();
    boolean isEmpty();
    int size();
    void delete(T n);
}

class DynamicArrayStack<T> implements MyStack<T> {
    private Object[] array;
    private int top;
    private int capacity;

    public DynamicArrayStack() {
        capacity = 10;
        array = new Object[capacity];
        top = -1;
    }

    public void push(T x) {
        if (top == capacity - 1) resize();
        array[++top] = x;
    }

    @SuppressWarnings("unchecked")
    public T pop() {
        if (isEmpty()) return null;
        T d = (T) array[top];
        array[top--] = null;
        return d;
    }

    @SuppressWarnings("unchecked")
    public T peek() { return isEmpty() ? null : (T) array[top]; }

    public boolean isEmpty() { return top == -1; }
    public int size() { return top + 1; }

    public void delete(T n) {
        for (int i = 0; i <= top; i++) {
            if (array[i].equals(n)) {
                for (int j = i; j < top; j++) array[j] = array[j + 1];
                array[top--] = null;
                return;
            }
        }
    }

    private void resize() {
        int newCap = capacity * 2;
        Object[] newArr = new Object[newCap];
        for (int i = 0; i < capacity; i++) newArr[i] = array[i];
        array = newArr;
        capacity = newCap;
    }
}

class DynamicArrayQueue<T> implements MyQueue<T> {
    private Object[] array;
    private int front;
    private int rear;
    private int size;
    private int capacity;

    public DynamicArrayQueue() {
        capacity = 10;
        array = new Object[capacity];
        front = 0;
        rear = -1;
        size = 0;
    }

    public void enqueue(T x) {
        if (size == capacity) resize();
        rear = (rear + 1) % capacity;
        array[rear] = x;
        size++;
    }

    @SuppressWarnings("unchecked")
    public T dequeue() {
        if (isEmpty()) return null;
        T d = (T) array[front];
        array[front] = null;
        front = (front + 1) % capacity;
        size--;
        return d;
    }

    @SuppressWarnings("unchecked")
    public T front() { return isEmpty() ? null : (T) array[front]; }

    public boolean isEmpty() { return size == 0; }
    public int size() { return size; }

    public void delete(T n) {
        int idx = -1;
        for (int i = 0; i < size; i++) {
            int ci = (front + i) % capacity;
            if (array[ci].equals(n)) { idx = ci; break; }
        }
        if (idx != -1) {
            for (int i = 0; i < size - 1; i++) {
                int ci = (front + i) % capacity;
                int ni = (front + i + 1) % capacity;
                array[ci] = array[ni];
            }
            rear = (rear - 1 + capacity) % capacity;
            array[(rear + 1) % capacity] = null;
            size--;
        }
    }

    private void resize() {
        int newCap = capacity * 2;
        Object[] newArr = new Object[newCap];
        for (int i = 0; i < size; i++) newArr[i] = array[(front + i) % capacity];
        array = newArr;
        front = 0;
        rear = size - 1;
        capacity = newCap;
    }
}


