        if (cur == null) return;
        if (cur == head) { pushFront(data); return; }
        NodeDouble<T> n = new NodeDouble<>(data);
        n.next = cur;
        n.prev = cur.prev;
        cur.prev.next = n;
        cur.prev = n;
        size++;
    }

    public void addAfter(T ref, T data) {
        NodeDouble<T> cur = head;
        while (cur != null && !cur.data.equals(ref)) cur = cur.next;
        if (cur == null) return;
        NodeDouble<T> n = new NodeDouble<>(data);
        n.prev = cur;
        n.next = cur.next;
